{
  "name": "gorczyca-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tablescribe-waitlist",
      "database_id": "bf93984a-29ff-4347-b9cf-cc304d93c6b9"
    }
  ],
  "observability": { "enabled": true }
}
